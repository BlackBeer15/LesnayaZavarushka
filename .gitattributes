# Нормализация переводов строк: в репозитории всегда LF, на Windows — CRLF.
* text=auto eol=crlf

*.gd text eol=lf
*.tscn text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.mp3 binary
*.png binary
*.uid text eol=lf
